+      auto lat = [](int x, int y, int period, uint32_t seed) { uint32_t h = (uint32_t)(x & (period - 1)) * 374761393u + (uint32_t)(y & (period - 1)) * 668265263u + seed * 2246822519u; h = (h ^ (h >> 13)) * 1274126177u; return (float)((h ^ (h >> 16)) & 0xFFFFu) / 65535.0f; };
